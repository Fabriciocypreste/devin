# RedFlix Frontend Environment Variables
# Copy this file to .env and fill in the values

# TMDB API Configuration
VITE_TMDB_API_KEY=your_tmdb_api_key_here
VITE_TMDB_BEARER_TOKEN=your_tmdb_bearer_token_here

# SUPABASE Configuration
# Get these from your Supabase project settings: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Service role key (backend only - DO NOT expose in frontend)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
